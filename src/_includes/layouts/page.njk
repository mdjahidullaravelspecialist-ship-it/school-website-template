{#- Inner-page shell: title band + breadcrumb. Front matter: title, lead, description, parent. #}
<div class="page-header">
  <div class="container">
    {%- if crumbs %}{% include "components/breadcrumb.njk" %}{% endif %}
    <h1>{{ title }}</h1>
    {%- if lead %}<p class="page-header__lead">{{ lead }}</p>{% endif %}
  </div>
</div>
{{ content | safe }}
